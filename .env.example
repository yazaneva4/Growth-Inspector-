# ── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role — server only, bypasses RLS for trusted server operations.
SUPABASE_SERVICE_ROLE_KEY=

# ── Authentication ─────────────────────────────────────────
# Supabase Auth owns authentication emails. Do not use these
# application-email settings for the Auth provider.
AUTH_EMAIL_HOOK_SECRET=
NEXT_PUBLIC_SITE_URL=

# ── Anthropic (the AI brain) ───────────────────────────────
ANTHROPIC_API_KEY=

# ── Google Gemini (free-tier fallback + Growth AI) ────────
GEMINI_API_KEY=

# ── GPT / OpenAI (Growth AI model option) ──────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# ── z.ai / Zhipu GLM ───────────────────────────────────────
ZAI_API_KEY=
ZAI_MODEL=glm-4.6

# ── OpenRouter (responder fallback tiers) ──────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL_A=openai/gpt-oss-120b:free
OPENROUTER_MODEL_B=google/gemma-4-31b-it:free

# ── Meta / WhatsApp & Instagram (webhooks + sending) ──────
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_APP_SECRET=

# ── Growth Inspector application email ────────────────────
# Separate from Supabase Auth. Used for invoices, access approvals,
# inbox replies, and Growth AI email actions.
# Preferred generic SMTP configuration:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Or use Gmail SMTP:
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Must be a real/verified sender for the selected provider.
EMAIL_FROM=

# Google sign-in
NEXT_PUBLIC_GOOGLE_ENABLED=

# ── Voice calls (Twilio) ───────────────────────────────────
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
