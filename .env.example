# ── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role — server only, bypasses RLS for trusted server operations.
SUPABASE_SERVICE_ROLE_KEY=

# ── Authentication ─────────────────────────────────────────
# Growth Inspector sends its own email verification messages.
# Supabase Auth remains the identity/session backend.
AUTH_EMAIL_HOOK_SECRET=
NEXT_PUBLIC_SITE_URL=

# ── Cloudflare Turnstile ───────────────────────────────────
# Get these from Cloudflare dashboard > Turnstile.
# The site key is public; the secret must remain server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET=your-turnstile-secret

# ── Anthropic (the AI brain) ───────────────────────────────
ANTHROPIC_API_KEY=

# ── Google Gemini (free-tier fallback + Growth AI) ────────
GEMINI_API_KEY=

# ── GPT / OpenAI (Growth AI model option) ──────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# ── z.ai / Zhipu GLM ───────────────────────────────────────
ZAI_API_KEY=
ZAI_MODEL=glm-4.6

# ── OpenRouter (responder fallback tiers) ──────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL_A=openai/gpt-oss-120b:free
OPENROUTER_MODEL_B=google/gemma-4-31b-it:free

# ── Meta / WhatsApp & Instagram (webhooks + sending) ──────
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_APP_SECRET=

# ── Growth Inspector application email ────────────────────
# Separate application transport for invoices, access approvals,
# inbox replies, Growth AI email actions, and authentication verification.
# Preferred generic SMTP configuration:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Or use Gmail SMTP:
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Must be a real/verified sender for the selected provider.
EMAIL_FROM=

# Google sign-in
NEXT_PUBLIC_GOOGLE_ENABLED=

# ── Voice calls (Twilio) ───────────────────────────────────
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
