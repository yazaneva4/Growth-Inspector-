# ── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role — server only, bypasses RLS for webhook ingestion. Also
# enables the sign-in self-heal for accounts stuck unconfirmed (see DEPLOY.md).
# From Supabase dashboard -> Project Settings -> API -> service_role. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic (the AI brain) ───────────────────────────────
ANTHROPIC_API_KEY=

# ── Google Gemini (free-tier fallback + Growth Agent) ──────
# Free API key from aistudio.google.com, no billing required. Used as the
# responder fallback when ANTHROPIC_API_KEY isn't set/errors, and powers the
# Growth Agent (autonomous analytics/competitor/trend research).
GEMINI_API_KEY=

# ── OpenRouter (three responder fallback tiers) ────────────
# One key from openrouter.ai/keys, shared by all three tiers. Full chain:
#   Claude -> Tier A -> Gemini -> Tier B -> Tier C -> friendly error.
# Each *_MODEL var is the exact slug from the model's OpenRouter page
# (click the copy icon next to "provider/model-name:free").
# WARNING: "...:free" endpoints may log prompts/outputs for training —
# for real customer data, use a zero-data-retention or paid model instead.
# Tencent Hy3 (tier C default) is marked "Going away July 21, 2026" on
# OpenRouter — swap OPENROUTER_MODEL_C for a replacement before then.
OPENROUTER_API_KEY=
OPENROUTER_MODEL_A=openai/gpt-oss-120b:free
OPENROUTER_MODEL_B=google/gemma-4-31b-it:free
OPENROUTER_MODEL_C=tencent/hy3:free

# ── Meta / WhatsApp & Instagram (webhooks + sending) ───────
META_VERIFY_TOKEN=
# System User access token (whatsapp_business_messaging + instagram_manage_messages
# permissions). Lets the agent actually SEND WhatsApp/Instagram DM replies —
# without it, sends are logged (dry-run) instead of delivered.
META_ACCESS_TOKEN=

# ── Outbound email (invoices, access approvals, inbox replies) ──
# Your real Gmail. Google account → Security → 2-Step Verification
# → App passwords → create one for "Mail". Sends as your Gmail address.
# Without these set, sends are logged (dry-run) instead of delivered.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Display name / sender override (Gmail keeps the authenticated address).
EMAIL_FROM=Growth Inspector <support@yourdomain.sa>
# Inbound email channel: point your provider's inbound-parse webhook at
# /api/webhooks/email.

# Google sign-in: the "Continue with Google" button stays hidden until this
# is set to true — so nobody is sent to a broken authorize page before Google
# is configured. Enable the Google provider in Supabase (Authentication →
# Providers → Google, with a Google Cloud OAuth client whose redirect URI is
# https://<project-ref>.supabase.co/auth/v1/callback), then set this to true.
NEXT_PUBLIC_GOOGLE_ENABLED=

# ── Voice calls (Twilio) ───────────────────────────────────
# Set the number's Voice webhook to POST https://<app>/api/voice
# and (optionally) its Status Callback to https://<app>/api/voice/status.
# Auth token enables verifying that webhook requests really came from Twilio;
# without it, the endpoints still work but skip signature verification.
TWILIO_AUTH_TOKEN=
# Account SID — required (along with TWILIO_AUTH_TOKEN) to download call
# recordings for Whisper transcription. Optional otherwise.
TWILIO_ACCOUNT_SID=

# ── Voice transcription upgrade (OpenAI Whisper) ───────────
# Optional. When this AND both Twilio vars above are set, calls switch from
# Twilio's built-in speech recognition to recording + Whisper transcription —
# meaningfully better accuracy on Saudi dialect and Arabic/English code-switching.
OPENAI_API_KEY=

# ── X / Twitter (lets the agent publish posts) ─────────────
# Developer Portal → your App → Keys and tokens. Needs an Access Token +
# Secret generated with "Read and Write" permission (User authentication
# context, OAuth 1.0a) so posts publish as your account.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

