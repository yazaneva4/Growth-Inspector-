# ── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role — server only, bypasses RLS for trusted server operations.
SUPABASE_SERVICE_ROLE_KEY=

# ── Authentication email hook ──────────────────────────────
# Secret generated by Supabase Auth Hooks. The Growth Inspector
# app verifies the signed hook and sends the authentication email itself.
# Supabase must be configured to use the Send Email Auth Hook; its SMTP
# sender is then not used for authentication emails.
AUTH_EMAIL_HOOK_SECRET=
NEXT_PUBLIC_SITE_URL=

# ── Anthropic (the AI brain) ───────────────────────────────
ANTHROPIC_API_KEY=

# ── Google Gemini (free-tier fallback + Growth AI) ────────
GEMINI_API_KEY=

# ── GPT / OpenAI (Growth AI model option) ──────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# ── z.ai / Zhipu GLM ───────────────────────────────────────
ZAI_API_KEY=
ZAI_MODEL=glm-4.6

# ── OpenRouter (responder fallback tiers) ──────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL_A=openai/gpt-oss-120b:free
OPENROUTER_MODEL_B=google/gemma-4-31b-it:free

# ── Meta / WhatsApp & Instagram (webhooks + sending) ──────
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_APP_SECRET=

# ── App-owned outbound email ───────────────────────────────
# Used by the app for invoices, access approvals, inbox replies,
# Growth AI email actions, and authentication emails received through
# the Supabase Send Email Auth Hook.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=Growth Inspector <support@yourdomain.sa>

# Google sign-in
NEXT_PUBLIC_GOOGLE_ENABLED=

# ── Voice calls (Twilio) ───────────────────────────────────
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
