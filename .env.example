# ── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role — server only, bypasses RLS for webhook ingestion. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic (the AI brain) ───────────────────────────────
ANTHROPIC_API_KEY=

# ── Meta / WhatsApp & Instagram webhooks ───────────────────
META_VERIFY_TOKEN=

# ── Email channel (Resend for sending replies) ─────────────
# Point your provider's inbound-parse webhook at /api/webhooks/email.
RESEND_API_KEY=
EMAIL_FROM=Growth Inspector <support@yourdomain.sa>

# Google sign-in is configured in the Supabase dashboard
# (Authentication → Providers → Google), not via env vars.
